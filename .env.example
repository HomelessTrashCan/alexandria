# Kopieren nach .env und mit echten Werten füllen. .env wird nicht versioniert.

SECRET_KEY=change-me-to-a-random-secret

# MariaDB-Verbindung (Treiber: PyMySQL)
DATABASE_URL=mysql+pymysql://cmdb_user:cmdb_password@localhost:3306/cmdb

# SMTP für Registrierungs-Bestätigung und Passwort-Reset.
# Bleibt MAIL_SERVER leer, werden E-Mails nur ins Log geschrieben (lokale Entwicklung).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=cmdb@example.com
